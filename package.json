{
  "name": "deepseek-harness-desktop",
  "version": "0.1.3",
  "description": "A macOS desktop container for DeepSeek Harness.",
  "private": true,
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-renderer.mjs",
    "dev": "pnpm build && electron .",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package:mac": "pnpm prepare:runtime && pnpm build && electron-builder --mac dmg",
    "prepare:runtime": "npm --prefix resources/runtime ci --omit=dev --ignore-scripts"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "ai.deepseek.harness.desktop",
    "productName": "DeepSeek Harness Desktop",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/adhoc-sign-macos.mjs",
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/runtime/package.json",
        "to": "runtime/package.json"
      },
      {
        "from": "resources/runtime/package-lock.json",
        "to": "runtime/package-lock.json"
      },
      {
        "from": "resources/runtime/node_modules",
        "to": "runtime/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "icon": "resources/app-icon.icns"
    }
  },
  "author": "DeepSeek Harness Desktop contributors",
  "license": "MIT"
}
